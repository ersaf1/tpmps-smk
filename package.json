{
  "name": "tpmps-workspace",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps scripts tests",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "bootstrap": "node --env-file=.env scripts/bootstrap.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "check:connection": "node --env-file=.env scripts/check-connection.mjs",
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "setup:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-preview.ps1",
    "test:preview": "node scripts/preview-check.mjs",
    "pretest:preview": "npm run build --workspace=@tpmps/api"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "25.5.0",
    "@types/pg": "^8.23.1",
    "eslint": "10.0.3",
    "pg": "8.20.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1"
  }
}
