# Frontend public configuration, compiled into Vite bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Empty = same origin /api; production reverse-proxies /api to Next.js.
VITE_API_URL=
API_PROXY_TARGET=http://127.0.0.1:3001

# Next.js server only. Never prefix secrets with VITE_ or NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Bootstrap only; remove password after successful setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Only for scripts/reconcile.mjs; do not commit real credentials.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
