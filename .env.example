NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Required exclusively by `npm run provision:users`.
# Never prefix this value with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

NEXT_PUBLIC_APP_NAME="SINTESA TPMPS"
NEXT_PUBLIC_APP_URL=https://your-production-domain.example
